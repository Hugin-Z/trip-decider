class MCPAppEnvelopeCase(unittest.TestCase):
    def setUp(self) -> None:
        application = _Application()
        self.adapter = TripMCPAdapter(application, _Query(application))

    def test_plan_envelope_contains_projected_badge_and_coordinate(self) -> None:
        view = self.adapter.render_trip_plan("run-one")

        badge = view["event_evidence"]["rail-outbound"]["badges"][0]
        self.assertEqual("verified", badge["token"])
        self.assertEqual(STAMP, badge["retrieved_at"])
        self.assertEqual("中国铁路12306", badge["sources"][0]["provider"])
        point = view["trip"]["presentation"]["map_payload"]["markers"][0]
        self.assertEqual(117.8, point["position"]["longitude"])

    def test_candidate_envelope_contains_fact_backed_poi_point(self) -> None:
        view = self.adapter.render_trip_candidates("run-one")

        marker = view["candidate_maps"]["candidate-one"]["markers"][0]
        self.assertEqual("坐标景点", marker["name"])
        self.assertEqual(29.25, marker["position"]["latitude"])

    def test_missing_coordinate_omits_map_without_losing_candidate_data(self) -> None:
        application = _NoCoordinateApplication()
        adapter = TripMCPAdapter(application, _Query(application))

        view = adapter.render_trip_candidates("run-one")

        self.assertEqual({}, view["candidate_maps"])
        self.assertEqual(
            "candidate-one",
            view["candidates"]["candidates"][0]["destination_id"],
        )

    def test_verification_envelope_contains_counts_tokens_and_next_action(self) -> None:
        view = self.adapter._verification_view(
            {
                "verify_id": "verify-one",
                "status": "COMPLETE",
                "total": 2,
                "checked": 2,
                "pending": 0,
                "findings": [
                    {
                        "index": 1,
                        "verdict": "conflicting",
                        "claim": {"train_code": "G100"},
                        "observed": {"train_code": "G101"},
                        "mismatches": [
                            {
                                "field": "train_code",
                                "claimed": "G100",
                                "observed": "G101",
                            }
                        ],
                        "retrieved_at": STAMP,
                        "suggested_action": "改成实查车次",
                    },
                    {
                        "index": 2,
                        "verdict": "unknown",
                        "claim": {"train_code": "G200"},
                        "observed": None,
                        "mismatches": [],
                        "retrieved_at": None,
                        "suggested_action": "稍后重查",
                    },
                ],
            }
        )

        self.assertEqual("verification", view["view"])
        self.assertEqual(2, view["summary"]["total"])
        self.assertEqual(1, view["summary"]["conflicting"])
        self.assertEqual(1, view["summary"]["unknown"])
        self.assertEqual("conflicting", view["findings"][0]["token"])
        self.assertEqual(
            "稍后重查",
            view["findings"][1]["next_action"]["detail"],
        )


class PresentationDoesNotGradeEvidenceCase(unittest.TestCase):
    def test_ui_has_no_token_vocabulary_condition_or_label_map(self) -> None:
        html = load_trip_mcp_app_html()
        script = html.split("<script>", 1)[1].split("</script>", 1)[0]
        token_literals = (
            "verified",
            "sourced_stale",
            "sourced_undated",
            "estimated_stale",
            "estimated_undated",
            "conflicting",
            "unknown",
        )
        conditional_lines = [
            line.strip()
            for line in script.splitlines()
            if re.search(r"\b(?:if|switch|case)\b|\?[^:]", line)
            and any(f'"{token}"' in line or f"'{token}'" in line for token in token_literals)
        ]
        self.assertEqual([], conditional_lines)
        self.assertNotIn("tokenLabels", script)
        self.assertIn("typeof item.token", script)
        self.assertIn("token.dataset.token = item.token", script)

    def test_single_resource_contains_all_three_renderers(self) -> None:
        html = load_trip_mcp_app_html()
        for renderer in ("renderCandidates", "renderPlan", "renderVerification"):
            self.assertIn(renderer, html)
        self.assertIn("mapFigure", html)



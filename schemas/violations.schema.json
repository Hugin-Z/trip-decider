{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trip-decider.example/schemas/0.1.0/violations.schema.json",
  "$defs": {
    "violation": {
      "type": "object",
      "required": [
        "violation_id",
        "kind",
        "message",
        "constraint_refs",
        "evidence_fact_refs",
        "proof_refs"
      ],
      "properties": {
        "violation_id": {
          "type": "string",
          "pattern": "^violation_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "kind": {"enum": ["hard", "environment", "conditional", "candidate_conflict"]},
        "message": {"type": "string", "minLength": 1},
        "constraint_refs": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/entity_id"}
        },
        "evidence_fact_refs": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/entity_id"}
        },
        "proof_refs": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/entity_id"}
        }
      },
      "additionalProperties": false
    },
    "proof": {
      "type": "object",
      "required": [
        "proof_id",
        "proof_type",
        "rule_id",
        "constraint_refs",
        "input_fact_ids",
        "bounds",
        "result"
      ],
      "properties": {
        "proof_id": {
          "type": "string",
          "pattern": "^proof_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "proof_type": {
          "enum": [
            "must_excluded_same_entity",
            "duration_lower_bound",
            "arrival_after_closing",
            "travel_activity_lower_bound",
            "single_base_commute_bound"
          ]
        },
        "rule_id": {"type": "string", "minLength": 1},
        "constraint_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "common.schema.json#/$defs/entity_id"}
        },
        "input_fact_ids": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/entity_id"}
        },
        "bounds": {
          "type": "object",
          "required": ["left", "operator", "right", "unit"],
          "properties": {
            "left": {"type": "number"},
            "operator": {"enum": [">", ">=", "<", "<=", "=="]},
            "right": {"type": "number"},
            "unit": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        },
        "result": {"const": "conflict_proven"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {"$ref": "common.schema.json#/$defs/envelope_base"},
    {
      "properties": {
        "artifact_type": {"const": "violations"},
        "payload": {
          "type": "object",
          "required": [
            "evaluation_stage",
            "plan_status",
            "violations",
            "conditions",
            "candidate_conflict_sets",
            "proofs"
          ],
          "properties": {
            "evaluation_stage": {"enum": ["pre_plan", "post_plan"]},
            "plan_status": {
              "enum": ["feasible", "conditionally_feasible", "proven_infeasible", "no_plan_found"]
            },
            "request_ref": {"$ref": "common.schema.json#/$defs/artifact_ref"},
            "constraint_set_ref": {"$ref": "common.schema.json#/$defs/artifact_ref"},
            "candidate_set_ref": {"$ref": "common.schema.json#/$defs/artifact_ref"},
            "evidence_set_ref": {"$ref": "common.schema.json#/$defs/artifact_ref"},
            "plan_ref": {"$ref": "common.schema.json#/$defs/artifact_ref"},
            "violations": {
              "type": "array",
              "items": {"$ref": "#/$defs/violation"}
            },
            "conditions": {
              "type": "array",
              "items": {"$ref": "common.schema.json#/$defs/condition"}
            },
            "candidate_conflict_sets": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["candidate_conflict_set_id", "constraint_refs", "evidence_fact_refs", "explanation"],
                "properties": {
                  "candidate_conflict_set_id": {"type": "string", "minLength": 1},
                  "constraint_refs": {
                    "type": "array",
                    "items": {"$ref": "common.schema.json#/$defs/entity_id"}
                  },
                  "evidence_fact_refs": {
                    "type": "array",
                    "items": {"$ref": "common.schema.json#/$defs/entity_id"}
                  },
                  "explanation": {"type": "string", "minLength": 1}
                },
                "additionalProperties": false
              }
            },
            "proofs": {
              "type": "array",
              "items": {"$ref": "#/$defs/proof"}
            }
          },
          "allOf": [
            {
              "if": {"properties": {"evaluation_stage": {"const": "pre_plan"}}},
              "then": {
                "required": ["request_ref", "constraint_set_ref", "candidate_set_ref", "evidence_set_ref"],
                "properties": {
                  "plan_status": {"const": "proven_infeasible"},
                  "proofs": {"minItems": 1}
                },
                "not": {"required": ["plan_ref"]}
              },
              "else": {
                "required": ["plan_ref"]
              }
            },
            {
              "if": {"properties": {"plan_status": {"const": "proven_infeasible"}}},
              "then": {"properties": {"proofs": {"minItems": 1}}}
            },
            {
              "if": {"properties": {"plan_status": {"const": "no_plan_found"}}},
              "then": {"properties": {"proofs": {"maxItems": 0}}}
            },
            {
              "if": {"properties": {"plan_status": {"const": "conditionally_feasible"}}},
              "then": {"properties": {"conditions": {"minItems": 1}}}
            }
          ],
          "additionalProperties": false
        }
      }
    }
  ]
}

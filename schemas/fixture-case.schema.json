{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trip-decider.example/schemas/0.1.0/fixture-case.schema.json",
  "type": "object",
  "required": [
    "case_id",
    "case_version",
    "fixture_type",
    "bundle_closure",
    "root_artifact_id",
    "source",
    "coverage",
    "non_coverage",
    "documents",
    "dirty_cases",
    "behavior_expected"
  ],
  "properties": {
    "case_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "case_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "fixture_type": {"enum": ["synthetic_deterministic", "real_anchor"]},
    "bundle_closure": {"enum": ["artifact_only", "closed"]},
    "root_artifact_id": {"$ref": "common.schema.json#/$defs/artifact_id"},
    "source": {
      "type": "object",
      "required": ["kind", "description"],
      "properties": {
        "kind": {"enum": ["frozen_contract", "user_supplied_anchor"]},
        "description": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "non_coverage": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["relative_path", "media_type", "content_utf8", "file_sha256", "expected_schema_id"],
        "properties": {
          "relative_path": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"},
          "media_type": {"enum": ["application/json", "application/yaml"]},
          "content_utf8": {"type": "string", "minLength": 1},
          "file_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
          "expected_schema_id": {"type": "string", "format": "uri"}
        },
        "additionalProperties": false
      }
    },
    "dirty_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["dirty_case_id", "target_document", "operation", "json_pointer", "expected_error"],
        "properties": {
          "dirty_case_id": {"type": "string", "minLength": 1},
          "target_document": {"type": "string", "minLength": 1},
          "operation": {"enum": ["add", "remove", "replace"]},
          "json_pointer": {"type": "string", "pattern": "^(|/.*)$"},
          "value": {},
          "expected_error": {
            "type": "object",
            "required": ["error_code", "json_pointer", "schema_rule"],
            "properties": {
              "error_code": {"type": "string", "minLength": 1},
              "json_pointer": {"type": "string", "pattern": "^(|/.*)$"},
              "schema_rule": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "allOf": [
          {
            "if": {"properties": {"operation": {"enum": ["add", "replace"]}}},
            "then": {"required": ["value"]},
            "else": {"not": {"required": ["value"]}}
          }
        ],
        "additionalProperties": false
      }
    },
    "behavior_expected": {
      "type": "object",
      "required": ["deferred_to", "spec"],
      "properties": {
        "deferred_to": {"type": "string", "pattern": "^WU[2-8]$"},
        "spec": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

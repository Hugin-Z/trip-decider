{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trip-decider.example/schemas/0.1.0/request.schema.json",
  "allOf": [
    {"$ref": "common.schema.json#/$defs/envelope_base"},
    {
      "properties": {
        "artifact_type": {"const": "request"},
        "payload": {
          "type": "object",
          "required": ["request_id", "natural_language", "explicit", "user_input_refs"],
          "properties": {
            "request_id": {
              "type": "string",
              "pattern": "^request_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "natural_language": {"type": "string", "minLength": 1},
            "explicit": {
              "type": "object",
              "required": ["origin", "travel_window", "party", "transport_modes", "destination", "preferences_raw"],
              "properties": {
                "origin": {"$ref": "common.schema.json#/$defs/locator"},
                "travel_window": {
                  "type": "object",
                  "required": ["start", "end", "timezone"],
                  "properties": {
                    "start": {"$ref": "common.schema.json#/$defs/date_time"},
                    "end": {"$ref": "common.schema.json#/$defs/date_time"},
                    "timezone": {"type": "string", "minLength": 1}
                  },
                  "additionalProperties": false
                },
                "party": {
                  "type": "object",
                  "required": ["count"],
                  "properties": {
                    "count": {"type": "integer", "minimum": 1}
                  },
                  "additionalProperties": false
                },
                "transport_modes": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "enum": ["driving", "walking", "transit", "cycling", "shuttle", "rail", "other"]
                  }
                },
                "destination": {
                  "type": "object",
                  "required": ["selection_mode"],
                  "properties": {
                    "selection_mode": {"enum": ["fixed", "undecided"]},
                    "name": {"type": "string", "minLength": 1}
                  },
                  "additionalProperties": false
                },
                "preferences_raw": {
                  "type": "array",
                  "items": {"type": "string", "minLength": 1}
                },
                "budget": {"type": ["number", "null"], "minimum": 0},
                "mobility": {"type": ["string", "null"]},
                "must_visit": {
                  "type": "array",
                  "items": {"type": "string", "minLength": 1}
                },
                "excluded": {
                  "type": "array",
                  "items": {"type": "string", "minLength": 1}
                },
                "clarifications": {
                  "type": "array",
                  "items": {"type": "string", "minLength": 1}
                },
                "locale": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            },
            "user_input_refs": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "common.schema.json#/$defs/locator"}
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}

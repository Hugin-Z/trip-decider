{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trip-decider.example/schemas/0.1.0/constraint-parse.schema.json",
  "allOf": [
    {"$ref": "common.schema.json#/$defs/envelope_base"},
    {
      "properties": {
        "artifact_type": {"const": "constraint-parse"},
        "payload": {
          "type": "object",
          "required": [
            "request_id",
            "request_ref",
            "parser",
            "parsed_constraints",
            "parse_notes",
            "needs_confirmation"
          ],
          "properties": {
            "request_id": {
              "type": "string",
              "pattern": "^request_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "request_ref": {"$ref": "common.schema.json#/$defs/artifact_ref"},
            "parser": {
              "type": "object",
              "required": ["name", "version", "kind"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "version": {"type": "string", "minLength": 1},
                "kind": {"enum": ["llm_structured", "user_structured"]}
              },
              "additionalProperties": false
            },
            "parsed_constraints": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "parse_item_id",
                  "constraint_id",
                  "user_quote",
                  "user_quote_locator",
                  "origin_kind",
                  "category",
                  "layer",
                  "normalized_expression",
                  "explanation",
                  "needs_confirmation"
                ],
                "properties": {
                  "parse_item_id": {
                    "type": "string",
                    "pattern": "^parse_item_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  "constraint_id": {
                    "type": "string",
                    "pattern": "^constraint_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  "user_quote": {"type": "string", "minLength": 1},
                  "user_quote_locator": {"$ref": "common.schema.json#/$defs/locator"},
                  "origin_kind": {"enum": ["explicit", "inferred"]},
                  "category": {"type": "string", "minLength": 1},
                  "layer": {"enum": ["hard", "soft", "environment"]},
                  "normalized_expression": {
                    "type": "object",
                    "required": ["operator", "value"],
                    "properties": {
                      "operator": {"type": "string", "minLength": 1},
                      "value": {},
                      "unit": {"type": ["string", "null"]}
                    },
                    "additionalProperties": false
                  },
                  "explanation": {"type": "string", "minLength": 1},
                  "needs_confirmation": {"type": "boolean"}
                },
                "additionalProperties": false
              }
            },
            "parse_notes": {
              "type": "array",
              "items": {"type": "string", "minLength": 1}
            },
            "needs_confirmation": {"type": "boolean"}
          },
          "additionalProperties": false
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trip-decider.example/schemas/0.1.0/plan-diff.schema.json",
  "allOf": [
    {"$ref": "common.schema.json#/$defs/envelope_base"},
    {
      "properties": {
        "artifact_type": {"const": "plan-diff"},
        "payload": {
          "type": "object",
          "required": [
            "previous_plan_id",
            "new_plan_id",
            "change_score",
            "weights",
            "changes",
            "unchanged_summary"
          ],
          "properties": {
            "previous_plan_id": {
              "type": "string",
              "pattern": "^plan_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "new_plan_id": {
              "type": "string",
              "pattern": "^plan_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "change_score": {"type": "number", "minimum": 0},
            "weights": {
              "type": "object",
              "required": [
                "same_day_reorder",
                "change_time_slot",
                "move_day",
                "change_base",
                "remove_activity",
                "add_activity"
              ],
              "properties": {
                "same_day_reorder": {"type": "number", "minimum": 0},
                "change_time_slot": {"type": "number", "minimum": 0},
                "move_day": {"type": "number", "minimum": 0},
                "change_base": {"type": "number", "minimum": 0},
                "remove_activity": {"type": "number", "minimum": 0},
                "add_activity": {"type": "number", "minimum": 0}
              },
              "additionalProperties": false
            },
            "changes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "change_id",
                  "type",
                  "entity",
                  "from",
                  "to",
                  "cost",
                  "reason",
                  "constraint_refs"
                ],
                "properties": {
                  "change_id": {
                    "type": "string",
                    "pattern": "^change_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  "type": {
                    "enum": [
                      "same_day_reorder",
                      "change_time_slot",
                      "move_day",
                      "change_base",
                      "remove_activity",
                      "add_activity",
                      "update"
                    ]
                  },
                  "entity": {
                    "type": "object",
                    "required": ["entity_kind", "entity_id", "resolution_scope"],
                    "properties": {
                      "entity_kind": {"enum": ["base_selection", "day", "activity", "leg"]},
                      "entity_id": {"$ref": "common.schema.json#/$defs/entity_id"},
                      "resolution_scope": {"enum": ["previous", "new", "either"]}
                    },
                    "additionalProperties": false
                  },
                  "from": {"type": ["object", "null"]},
                  "to": {"type": ["object", "null"]},
                  "cost": {"type": "number", "minimum": 0},
                  "reason": {"type": "string", "minLength": 1},
                  "constraint_refs": {
                    "type": "array",
                    "items": {"$ref": "common.schema.json#/$defs/entity_id"}
                  }
                },
                "additionalProperties": false
              }
            },
            "unchanged_summary": {
              "type": "object",
              "required": ["activity_count", "day_count"],
              "properties": {
                "activity_count": {"type": "integer", "minimum": 0},
                "day_count": {"type": "integer", "minimum": 0}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}

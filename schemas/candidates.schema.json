{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trip-decider.example/schemas/0.1.0/candidates.schema.json",
  "allOf": [
    {"$ref": "common.schema.json#/$defs/envelope_base"},
    {
      "properties": {
        "artifact_type": {"const": "candidates"},
        "payload": {
          "type": "object",
          "required": [
            "candidate_set_id",
            "request_ref",
            "generation_stage",
            "candidates",
            "rejected_inputs"
          ],
          "properties": {
            "candidate_set_id": {
              "type": "string",
              "pattern": "^candidate_set_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "request_ref": {"$ref": "common.schema.json#/$defs/artifact_ref"},
            "generation_stage": {
              "enum": ["destination_pass_through", "poi_discovery", "destination_recommendation", "base_area_generation"]
            },
            "candidates": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "candidate_id",
                  "candidate_kind",
                  "label",
                  "parent_candidate_id",
                  "location",
                  "source_refs",
                  "evidence_fact_refs",
                  "generation_reason"
                ],
                "properties": {
                  "candidate_id": {
                    "type": "string",
                    "pattern": "^candidate_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  "candidate_kind": {"enum": ["destination", "base_area", "poi"]},
                  "label": {"type": "string", "minLength": 1},
                  "parent_candidate_id": {
                    "oneOf": [
                      {
                        "type": "string",
                        "pattern": "^candidate_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                      },
                      {"type": "null"}
                    ]
                  },
                  "location": {
                    "oneOf": [
                      {
                        "type": "object",
                        "required": ["kind", "latitude", "longitude"],
                        "properties": {
                          "kind": {"const": "coordinates"},
                          "latitude": {"type": "number", "minimum": -90, "maximum": 90},
                          "longitude": {"type": "number", "minimum": -180, "maximum": 180}
                        },
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "required": ["kind", "query"],
                        "properties": {
                          "kind": {"const": "unresolved"},
                          "query": {"type": "string", "minLength": 1}
                        },
                        "additionalProperties": false
                      }
                    ]
                  },
                  "source_refs": {
                    "type": "array",
                    "items": {"$ref": "common.schema.json#/$defs/locator"}
                  },
                  "evidence_fact_refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^fact_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                    }
                  },
                  "generation_reason": {"type": "string", "minLength": 1},
                  "coarse_feasibility_refs": {
                    "type": "array",
                    "items": {"type": "string", "minLength": 1}
                  },
                  "coarse_plan_refs": {
                    "type": "array",
                    "items": {"type": "string", "minLength": 1}
                  }
                },
                "additionalProperties": false
              }
            },
            "rejected_inputs": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["label", "reason", "locator"],
                "properties": {
                  "label": {"type": "string", "minLength": 1},
                  "reason": {"type": "string", "minLength": 1},
                  "locator": {"$ref": "common.schema.json#/$defs/locator"}
                },
                "additionalProperties": false
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "generation_stage": {"const": "destination_recommendation"}
                }
              },
              "then": {
                "properties": {
                  "candidates": {
                    "items": {
                      "required": ["coarse_feasibility_refs", "coarse_plan_refs"]
                    }
                  }
                }
              }
            }
          ],
          "additionalProperties": false
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trip-decider.example/schemas/0.1.0/common.schema.json",
  "$defs": {
    "envelope_base": {
      "type": "object",
      "required": [
        "schema_version",
        "artifact_id",
        "artifact_type",
        "created_at",
        "producer",
        "provenance",
        "integrity",
        "payload"
      ],
      "properties": {
        "schema_version": {"$ref": "#/$defs/schema_version"},
        "artifact_id": {"$ref": "#/$defs/artifact_id"},
        "artifact_type": {"type": "string", "minLength": 1},
        "created_at": {"$ref": "#/$defs/date_time"},
        "producer": {"$ref": "#/$defs/producer"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "integrity": {"$ref": "#/$defs/integrity"},
        "payload": {"type": "object"}
      },
      "additionalProperties": false
    },
    "schema_version": {
      "type": "string",
      "pattern": "^0\\.[0-9]+\\.[0-9]+$"
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "entity_id": {
      "type": "string",
      "pattern": "^(request|parse_item|constraint_set|constraint|candidate_set|candidate|evidence_set|fact|plan|base_selection|day|activity|leg|violation|proof|change|run|case)_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "date_time": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "producer": {
      "type": "object",
      "required": ["name", "version", "run_id"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "run_id": {"$ref": "#/$defs/entity_id"}
      },
      "additionalProperties": false
    },
    "input_hash": {
      "type": "object",
      "required": ["name", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["parent_artifact_ids", "input_hashes", "pipeline_stage"],
      "properties": {
        "parent_artifact_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/artifact_id"},
          "uniqueItems": true
        },
        "input_hashes": {
          "type": "array",
          "items": {"$ref": "#/$defs/input_hash"}
        },
        "pipeline_stage": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "integrity": {
      "type": "object",
      "required": ["payload_sha256", "canonicalization"],
      "properties": {
        "payload_sha256": {"$ref": "#/$defs/sha256"},
        "canonicalization": {
          "const": "canonical-json-v1"
        }
      },
      "additionalProperties": false
    },
    "artifact_ref": {
      "type": "object",
      "required": ["artifact_id", "artifact_type", "schema_version", "payload_sha256"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/artifact_id"},
        "artifact_type": {
          "enum": [
            "request",
            "constraint-parse",
            "constraints",
            "candidates",
            "evidence",
            "previous-plan",
            "plan",
            "plan-diff",
            "violations"
          ]
        },
        "schema_version": {"$ref": "#/$defs/schema_version"},
        "payload_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "locator": {
      "type": "object",
      "required": ["kind", "value"],
      "properties": {
        "kind": {
          "enum": [
            "user_input",
            "provider_item",
            "search_result",
            "web_location",
            "response_location",
            "observation_location",
            "pipeline_record"
          ]
        },
        "value": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "origin": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "refs"],
          "properties": {
            "kind": {"const": "explicit"},
            "refs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["parse_item_id", "locator"],
                "properties": {
                  "parse_item_id": {"$ref": "#/$defs/entity_id"},
                  "locator": {"$ref": "#/$defs/locator"}
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "refs", "parser_version"],
          "properties": {
            "kind": {"const": "inferred"},
            "refs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["parse_item_id"],
                "properties": {
                  "parse_item_id": {"$ref": "#/$defs/entity_id"}
                },
                "additionalProperties": false
              }
            },
            "parser_version": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "rule_id", "rule_version", "explanation"],
          "properties": {
            "kind": {"const": "default"},
            "rule_id": {"type": "string", "minLength": 1},
            "rule_version": {"type": "string", "minLength": 1},
            "explanation": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "replaced_value", "edited_at", "locator"],
          "properties": {
            "kind": {"const": "user_edited"},
            "replaced_value": {},
            "edited_at": {"$ref": "#/$defs/date_time"},
            "locator": {"$ref": "#/$defs/locator"}
          },
          "additionalProperties": false
        }
      ]
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "required": ["source_id", "source_type", "url", "publisher", "published_at", "retrieved_at", "excerpt", "locator"],
          "properties": {
            "source_id": {"type": "string", "pattern": "^source_[a-z0-9_-]+$"},
            "source_type": {"enum": ["webpage", "official_notice"]},
            "url": {"type": "string", "format": "uri"},
            "publisher": {"type": "string", "minLength": 1},
            "published_at": {
              "oneOf": [
                {"$ref": "#/$defs/date_time"},
                {"type": "null"}
              ]
            },
            "published_at_absence_reason": {"type": "string", "minLength": 1},
            "retrieved_at": {"$ref": "#/$defs/date_time"},
            "excerpt": {"type": "string", "minLength": 1},
            "locator": {"$ref": "#/$defs/locator"}
          },
          "allOf": [
            {
              "if": {"properties": {"published_at": {"type": "null"}}},
              "then": {"required": ["published_at_absence_reason"]}
            }
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["source_id", "source_type", "provider", "operation", "retrieved_at", "request_fingerprint", "response_locator"],
          "properties": {
            "source_id": {"type": "string", "pattern": "^source_[a-z0-9_-]+$"},
            "source_type": {"const": "api_response"},
            "provider": {"type": "string", "minLength": 1},
            "operation": {"type": "string", "minLength": 1},
            "retrieved_at": {"$ref": "#/$defs/date_time"},
            "request_fingerprint": {"$ref": "#/$defs/sha256"},
            "response_locator": {"$ref": "#/$defs/locator"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["source_id", "source_type", "observer_type", "observed_at", "observation", "location_ref"],
          "properties": {
            "source_id": {"type": "string", "pattern": "^source_[a-z0-9_-]+$"},
            "source_type": {"const": "direct_observation"},
            "observer_type": {"enum": ["user", "field_researcher", "operator"]},
            "observed_at": {"$ref": "#/$defs/date_time"},
            "observation": {"type": "string", "minLength": 1},
            "location_ref": {"$ref": "#/$defs/locator"}
          },
          "additionalProperties": false
        }
      ]
    },
    "condition": {
      "type": "object",
      "required": ["condition_id", "description", "constraint_refs", "evidence_fact_refs"],
      "properties": {
        "condition_id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "constraint_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/entity_id"}
        },
        "evidence_fact_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/entity_id"}
        }
      },
      "additionalProperties": false
    },
    "base_selection": {
      "type": "object",
      "required": [
        "base_selection_id",
        "candidate_ref",
        "constraint_refs",
        "evidence_fact_refs"
      ],
      "properties": {
        "base_selection_id": {
          "type": "string",
          "pattern": "^base_selection_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "candidate_ref": {
          "type": "string",
          "pattern": "^candidate_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "constraint_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/entity_id"}
        },
        "evidence_fact_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/entity_id"}
        }
      },
      "additionalProperties": false
    },
    "activity": {
      "type": "object",
      "required": [
        "activity_id",
        "candidate_ref",
        "start_at",
        "end_at",
        "constraint_refs",
        "evidence_fact_refs"
      ],
      "properties": {
        "activity_id": {
          "type": "string",
          "pattern": "^activity_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "candidate_ref": {
          "type": "string",
          "pattern": "^candidate_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "start_at": {"$ref": "#/$defs/date_time"},
        "end_at": {"$ref": "#/$defs/date_time"},
        "constraint_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/entity_id"}
        },
        "evidence_fact_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/entity_id"}
        }
      },
      "additionalProperties": false
    },
    "leg": {
      "type": "object",
      "required": ["leg_id", "mode", "duration_minutes", "derivation_fact_ref"],
      "properties": {
        "leg_id": {
          "type": "string",
          "pattern": "^leg_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "mode": {"enum": ["driving", "walking", "transit", "cycling", "shuttle", "rail", "other"]},
        "duration_minutes": {"type": "number", "minimum": 0},
        "derivation_fact_ref": {
          "type": "string",
          "pattern": "^fact_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      },
      "additionalProperties": false
    },
    "day": {
      "type": "object",
      "required": ["day_id", "date", "activities", "legs"],
      "properties": {
        "day_id": {
          "type": "string",
          "pattern": "^day_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "date": {"type": "string", "format": "date"},
        "activities": {
          "type": "array",
          "items": {"$ref": "#/$defs/activity"}
        },
        "legs": {
          "type": "array",
          "items": {"$ref": "#/$defs/leg"}
        }
      },
      "additionalProperties": false
    }
  }
}

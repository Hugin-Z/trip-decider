{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trip-decider.example/schemas/0.1.0/plan.schema.json",
  "allOf": [
    {"$ref": "common.schema.json#/$defs/envelope_base"},
    {
      "properties": {
        "artifact_type": {"const": "plan"},
        "payload": {
          "type": "object",
          "required": [
            "plan_id",
            "request_ref",
            "constraint_set_ref",
            "candidate_set_ref",
            "evidence_set_ref",
            "plan_status",
            "conditions",
            "base_selections",
            "days",
            "excluded_candidates",
            "constraint_evaluations",
            "objective_breakdown",
            "proof_refs"
          ],
          "properties": {
            "plan_id": {
              "type": "string",
              "pattern": "^plan_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "request_ref": {"$ref": "common.schema.json#/$defs/artifact_ref"},
            "constraint_set_ref": {"$ref": "common.schema.json#/$defs/artifact_ref"},
            "candidate_set_ref": {"$ref": "common.schema.json#/$defs/artifact_ref"},
            "evidence_set_ref": {"$ref": "common.schema.json#/$defs/artifact_ref"},
            "previous_plan_ref": {"$ref": "common.schema.json#/$defs/artifact_ref"},
            "plan_status": {
              "enum": ["feasible", "conditionally_feasible", "proven_infeasible", "no_plan_found"]
            },
            "conditions": {
              "type": "array",
              "items": {"$ref": "common.schema.json#/$defs/condition"}
            },
            "base_selections": {
              "type": "array",
              "items": {"$ref": "common.schema.json#/$defs/base_selection"}
            },
            "days": {
              "type": "array",
              "items": {"$ref": "common.schema.json#/$defs/day"}
            },
            "excluded_candidates": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["candidate_ref", "reason", "constraint_refs", "evidence_fact_refs"],
                "properties": {
                  "candidate_ref": {
                    "type": "string",
                    "pattern": "^candidate_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  "reason": {"type": "string", "minLength": 1},
                  "constraint_refs": {
                    "type": "array",
                    "items": {"$ref": "common.schema.json#/$defs/entity_id"}
                  },
                  "evidence_fact_refs": {
                    "type": "array",
                    "items": {"$ref": "common.schema.json#/$defs/entity_id"}
                  }
                },
                "additionalProperties": false
              }
            },
            "constraint_evaluations": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["constraint_ref", "result"],
                "properties": {
                  "constraint_ref": {"$ref": "common.schema.json#/$defs/entity_id"},
                  "result": {"enum": ["satisfied", "unsatisfied", "conditional", "not_evaluated"]}
                },
                "additionalProperties": false
              }
            },
            "objective_breakdown": {
              "type": "object",
              "required": ["components"],
              "properties": {
                "components": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["name", "value"],
                    "properties": {
                      "name": {"type": "string", "minLength": 1},
                      "value": {"type": "number"}
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            },
            "proof_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^proof_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              }
            }
          },
          "allOf": [
            {
              "if": {"properties": {"plan_status": {"const": "feasible"}}},
              "then": {
                "properties": {
                  "conditions": {"maxItems": 0},
                  "days": {"minItems": 1},
                  "proof_refs": {"maxItems": 0}
                }
              }
            },
            {
              "if": {"properties": {"plan_status": {"const": "conditionally_feasible"}}},
              "then": {
                "properties": {
                  "conditions": {"minItems": 1},
                  "days": {"minItems": 1},
                  "proof_refs": {"maxItems": 0}
                }
              }
            },
            {
              "if": {"properties": {"plan_status": {"const": "proven_infeasible"}}},
              "then": {
                "properties": {
                  "days": {"maxItems": 0},
                  "proof_refs": {"minItems": 1}
                }
              }
            },
            {
              "if": {"properties": {"plan_status": {"const": "no_plan_found"}}},
              "then": {
                "properties": {
                  "days": {"maxItems": 0},
                  "proof_refs": {"maxItems": 0}
                }
              }
            }
          ],
          "additionalProperties": false
        }
      }
    }
  ]
}
